<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Confirm New Email</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f7f5;font-family:Arial,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f7f5;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
            <tr>
              <td style="background:#416A53;padding:18px 24px;color:#ffffff;font-size:20px;font-weight:700;">
                <%= appName || 'EduFlow Pro' %>
              </td>
            </tr>
            <tr>
              <td style="padding:24px;">
                <p style="margin:0 0 12px 0;font-size:16px;">Hello <%= name %>,</p>
                <p style="margin:0 0 16px 0;line-height:1.6;">Use this code to confirm your new email address:</p>
                <p style="margin:0 0 18px 0;">
                  <span style="display:inline-block;background:#eef4f1;border:1px solid #d5e2db;color:#416A53;font-size:22px;letter-spacing:4px;font-weight:700;padding:10px 14px;border-radius:6px;">
                    <%= otp %>
                  </span>
                </p>
                <p style="margin:0 0 18px 0;color:#6b7280;line-height:1.6;">Do not share this code with anyone.</p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 24px;background:#f8faf9;border-top:1px solid #e5e7eb;">
                <p style="margin:0 0 8px 0;color:#4b5563;font-size:12px;line-height:1.6;">
                  This is an official account update message from <strong><%= appName || 'EduFlow Pro' %></strong> LMS.
                </p>
                <p style="margin:0 0 8px 0;color:#6b7280;font-size:12px;line-height:1.6;">
                  Use this code only to confirm your own email change request.
                </p>
                <p style="margin:0;color:#9ca3af;font-size:12px;line-height:1.6;">
                  If you did not request an email change, please review your account security.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
