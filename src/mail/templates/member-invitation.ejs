<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Invitation</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f7f5;font-family:Arial,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f7f5;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
            <tr>
              <td style="background:#416A53;padding:18px 24px;color:#ffffff;font-size:20px;font-weight:700;">
                <%= process.env.APP_NAME || 'EduFlow Pro' %>
              </td>
            </tr>
            <tr>
              <td style="padding:24px;">
                <p style="margin:0 0 12px 0;font-size:16px;">Hello <%= member.fname %>,</p>
                <p style="margin:0 0 16px 0;line-height:1.6;">
                  <strong><%= user.fname %> <%= user.lname %></strong> (<%= user.email %>) invited you to join
                  <strong><%= process.env.APP_NAME || 'EduFlow Pro' %></strong>.
                </p>
                <p style="margin:0 0 22px 0;line-height:1.6;">
                  Join your workspace and start collaborating with your team in one place.
                </p>
                <p style="margin:0 0 22px 0;">
                  <a href="<%= url %>" style="display:inline-block;background:#416A53;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;font-weight:600;">
                    Accept Invitation
                  </a>
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 24px;background:#f8faf9;border-top:1px solid #e5e7eb;">
                <p style="margin:0 0 8px 0;color:#4b5563;font-size:12px;line-height:1.6;">
                  This invitation is sent through <strong><%= process.env.APP_NAME || 'EduFlow Pro' %></strong> Learning Management System.
                </p>
                <p style="margin:0 0 8px 0;color:#6b7280;font-size:12px;line-height:1.6;">
                  Access is intended for the invited recipient only. Please do not forward this email without permission.
                </p>
                <p style="margin:0;color:#9ca3af;font-size:12px;line-height:1.6;">
                  If you were not expecting this invitation, you may safely ignore this message.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>