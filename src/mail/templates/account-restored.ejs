<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your Account Has Been Restored</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f7f5;font-family:Arial,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f7f5;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
            <tr>
              <td style="background:#416A53;padding:18px 24px;color:#ffffff;font-size:20px;font-weight:700;">
                Account Restored
              </td>
            </tr>
            <tr>
              <td style="padding:24px;">
                <p style="margin:0 0 12px 0;font-size:16px;">Hello <%= name %>,</p>
                <p style="margin:0 0 18px 0;line-height:1.6;">
                  Great news! Your account on <strong><%= appName || 'EduFlow Pro' %></strong> has been restored and you can now log in again.
                </p>
                <% if (reason) { %>
                <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:16px;margin:0 0 22px 0;">
                  <p style="margin:0;font-size:14px;color:#166534;line-height:1.6;"><%= reason %></p>
                </div>
                <% } %>
                <p style="margin:0 0 22px 0;">
                  <a href="<%= loginUrl %>" style="display:inline-block;background:#416A53;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;font-weight:600;">
                    Log In to Your Account
                  </a>
                </p>
                <p style="margin:0 0 18px 0;color:#6b7280;font-size:14px;line-height:1.6;">
                  We welcome you back! If you have any questions or need assistance, please don't hesitate to reach out.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 24px;background:#f8faf9;border-top:1px solid #e5e7eb;">
                <p style="margin:0 0 8px 0;color:#4b5563;font-size:12px;line-height:1.6;">
                  This is an official notification from <strong><%= appName || 'EduFlow Pro' %></strong>, a Learning Management System.
                </p>
                <p style="margin:0 0 8px 0;color:#6b7280;font-size:12px;line-height:1.6;">
                  By using the platform, you agree to our Terms of Service and Privacy Policy.
                </p>
                <p style="margin:0;color:#9ca3af;font-size:12px;line-height:1.6;">
                  If you did not request this, please contact our support team immediately.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>